{
    "name": "publishdigital/walkie-talkie",
    "description": "Sistema Walkie Talkie web em tempo real - WebRTC + WebSocket + PWA",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "cboden/ratchet": "^0.4.4",
        "ratchet/pawl": "^0.4.1",
        "react/event-loop": "^1.5",
        "firebase/php-jwt": "^6.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "WalkieTalkie\\": "classes/"
        }
    },
    "scripts": {
        "ws-server": "php websocket/server.php",
        "install-db": "php database/install.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
