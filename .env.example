# =========================================
# WALKIE TALKIE - Variáveis de Ambiente
# =========================================
# Copie este arquivo para .env e ajuste

APP_NAME="Walkie Talkie"
# Fonte única da versão: alimenta a tela, o manifest e o cache do Service Worker
APP_VERSION=1.8.0
APP_ENV=production
APP_DEBUG=false
APP_URL=https://walkie.seudominio.com
APP_TIMEZONE=America/Sao_Paulo
# OBRIGATÓRIO em produção (mín. 32 chars). Gere com:
#   php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=gere-uma-chave-aleatoria-com-openssl-rand-hex-32

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=walkie_talkie
DB_USERNAME=walkie_user
DB_PASSWORD=senha_super_segura_aqui

# WebSocket
WS_HOST=0.0.0.0
WS_PORT=8080
WS_PUBLIC_URL=wss://walkie.seudominio.com/ws

# PTT (Push To Talk)
PTT_MAX_TALK=30
PTT_COOLDOWN=1
PTT_ATTENTION_COOLDOWN=60

# Nomes que exigem senha (não podem ser usados no login guest)
RESERVED_NAMES=ALEQUIZAO,admin,administrador,suporte

# TURN (opcional, mas necessário para chamadas em NAT restritivo/simétrico)
# Sem TURN, só STUN — algumas ligações não completam.
#TURN_URL=turn:seu-turn.exemplo.com:3478
#TURN_USER=usuario
#TURN_PASS=senha

# Logs
LOG_LEVEL=info
